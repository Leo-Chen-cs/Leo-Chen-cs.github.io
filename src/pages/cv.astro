---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationList from '../components/PublicationList.astro';
---

<BaseLayout title="CV · Haotian Chen" description="Curriculum vitae of Haotian Chen.">
  <header class="page-hero"><div class="shell"><p class="eyebrow">Curriculum vitae</p><h1>Education, research, and experience.</h1><div class="button-row" style="margin-top:1.5rem"><a class="button primary" href="/cv/haotian-chen-cv.pdf" download>Download CV</a><a class="button" href="mailto:cht@my.swjtu.edu.cn">Contact</a></div></div></header>
  <div class="shell page">
    <section class="cv-section">
      <h2>Education</h2>
      <div>
        <article class="cv-item branded">
          <img src="/images/institutions/ustc.png" alt="University of Science and Technology of China emblem" />
          <div><div class="cv-item-head"><h3>University of Science and Technology of China</h3><time>2026 — 2029</time></div><p>M.S. in Cyberspace Security · Research focus: large language model security</p></div>
        </article>
        <article class="cv-item branded">
          <img src="/images/institutions/swjtu.png" alt="Southwest Jiaotong University emblem" />
          <div><div class="cv-item-head"><h3>Southwest Jiaotong University</h3><time>2022 — 2026</time></div><p>Undergraduate study in Computer Science and Technology at the SWJTU–Leeds Joint School · Average 91.23 · Rank 8 / 82</p></div>
        </article>
        <article class="cv-item branded wide-logo-item">
          <img class="wide-wordmark" src="/images/institutions/leeds.svg" alt="University of Leeds logo" />
          <div><div class="cv-item-head"><h3>University of Leeds</h3><time>2022 — 2026</time></div><p>Dual-degree undergraduate programme in Computer Science through the SWJTU–Leeds Joint School</p></div>
        </article>
      </div>
    </section>
    <section class="cv-section"><h2>Research interests</h2><div class="focus-list" style="margin-top:0"><span>LLM Agents</span><span>Memory & Personalization</span><span>Social Simulation</span><span>3D Intelligence</span><span>Computer Vision</span></div></section>
    <section class="cv-section"><h2>Research experience</h2><div><article class="cv-item branded"><img src="/images/institutions/tsinghua.jpg" alt="Tsinghua University emblem" /><div><div class="cv-item-head"><h3>Research Intern · Institute for AI Industry Research, Tsinghua University</h3><time>2024.07 — 2025.04</time></div><p>Collaborated on computer vision and artificial intelligence research for robot target recognition and autonomous navigation, contributing to project implementation and experimentation.</p></div></article><article class="cv-item"><div class="cv-item-head"><h3>DPNet · Research Assistant</h3><time>2024.11 — 2025.05</time></div><p>Co-developed a dynamic pooling network for efficient tiny-object detection and contributed as co-first author.</p></article><article class="cv-item"><div class="cv-item-head"><h3>Interactive broadcast gymnastics system · Project Lead</h3><time>2024.08 — 2024.11</time></div><p>Designed a mobile real-time pose-estimation, movement-comparison, and visual-feedback system.</p></article></div></section>
    <section class="cv-section"><h2>Industry</h2><div><article class="cv-item branded"><img class="wordmark" src="/images/institutions/zte.jpg" alt="ZTE logo" /><div><div class="cv-item-head"><h3>Software Development Intern · ZTE, Chengdu</h3><time>2024.07 — 2024.08</time></div><p>Built an automated kernel-configuration inspection tool for the operating-system product team, cutting review time from about 30 minutes to 5 minutes while achieving over 98% inspection accuracy.</p></div></article></div></section>
    <section class="cv-section"><h2>Publications</h2><div><PublicationList /></div></section>
    <section class="cv-section"><h2>Honors</h2><div class="cv-item"><ul><li>National First Prize, National College Student Mechanical Engineering Innovation Competition, 2024</li><li>National Second Prize, National College Business Elite Challenge Innovation & Entrepreneurship Competition, 2024</li><li>National Third Prize, China International College Students’ Innovation Competition, 2024</li><li>National Third Prize, Challenge Cup National College Student Entrepreneurship Competition, 2024</li><li>National Third Prize, RAICOM National Finals, 2025</li><li>Nitori International Scholarship</li></ul></div></section>
    <section class="cv-section"><h2>Skills</h2><div class="cv-item"><p>Python, C, C++, Java · deep learning, computer vision, data mining, web development</p><p>English: CET-6 (565)</p></div></section>
  </div>
</BaseLayout>
