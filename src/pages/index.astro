---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationList from '../components/PublicationList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile, researchAreas } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout>
  <div class="site-shell home">
    <section class="home-top">
      <aside class="profile-block">
        <img class="profile-avatar" src="/images/haotian-chen-life.jpg" alt="Portrait of Haotian Chen" width="900" height="900" />
        <div class="profile-name"><h1>{profile.name}</h1><span class="cn-name">陈皓天</span></div>
        <p class="profile-role">{profile.role}<br />{profile.institution}</p>
        <div class="contact-block">
          <a class="contact-link" href={`mailto:${profile.email}`}>Email</a>
          <a class="contact-link" href="/cv/haotian-chen-cv.pdf" download>Curriculum Vitae</a>
          <a class="contact-link" href="https://arxiv.org/search/cs?searchtype=author&query=Chen%2C+Haotian" target="_blank" rel="noreferrer">arXiv profile</a>
          <span class="contact-link muted">GitHub · add link</span>
        </div>
        <p class="profile-note">Agents should not only sound plausible — they should remember, act, and remain auditable.</p>
      </aside>

      <div class="about-section">
        <h2>About</h2>
        <p>I am an M.S. student in Cyberspace Security at the <strong>University of Science and Technology of China</strong>. My work sits at the intersection of large language model agents, memory systems, social simulation, and embodied intelligence.</p>
        <p>{profile.intro}</p>
        <p>Previously, I studied Computer Science and Technology at <strong>Southwest Jiaotong University</strong>. I also collaborated with the <strong>Institute for AI Industry Research (AIR), Tsinghua University</strong> as a research intern and worked with the operating-system product team at <strong>ZTE</strong>.</p>
        <p class="interests-label">Research interests</p>
        <ul class="interest-list">
          <li><strong>LLM agents</strong> — execution semantics, evaluation, and reliable interaction</li>
          <li><strong>Memory & personalization</strong> — selective retrieval, updating, and behavioral consistency</li>
          <li><strong>Social simulation</strong> — grounded actions and traceable world-state transitions</li>
          <li><strong>3D intelligence</strong> — multimodal understanding, generation, and spatial evaluation</li>
        </ul>
      </div>
    </section>

    <section class="divided-section" id="research">
      <div class="section-head"><h2>Research <span class="count">04</span></h2><a class="text-link" href="/research/">View research page</a></div>
      <div class="area-grid">{researchAreas.map((area) => <article class="area-card"><span class="number">{area.index}</span><h3>{area.title}</h3><p>{area.description}</p></article>)}</div>
    </section>

    <section class="divided-section">
      <div class="section-head"><h2>Publications <span class="count">04</span></h2><span>Selected research outputs</span></div>
      <PublicationList />
    </section>

    <section class="divided-section">
      <div class="section-head"><h2>Projects <span class="count">03</span></h2><a class="text-link" href="/projects/">View all</a></div>
      <div class="project-grid">{projects.map((project) => <ProjectCard id={project.id} {...project.data} />)}</div>
    </section>

    <section class="divided-section">
      <div class="section-head"><h2>Education & Experience <span class="count">04</span></h2><a class="text-link" href="/cv/">Full CV</a></div>
      <div class="affiliation-grid">
        <article class="affiliation-card">
          <img src="/images/institutions/ustc.png" alt="University of Science and Technology of China emblem" />
          <div><time>2026 — 2029</time><h3>University of Science and Technology of China</h3><p>M.S. in Cyberspace Security, focusing on large language model security and reliable agents.</p></div>
        </article>
        <article class="affiliation-card">
          <img src="/images/institutions/swjtu.png" alt="Southwest Jiaotong University emblem" />
          <div><time>2022 — 2026</time><h3>Southwest Jiaotong University</h3><p>B.Eng. in Computer Science and Technology. Average 91.23; ranked 8 / 82.</p></div>
        </article>
        <article class="affiliation-card">
          <img src="/images/institutions/tsinghua.jpg" alt="Tsinghua University emblem" />
          <div><time>2024.07 — 2025.04</time><h3>Tsinghua AIR · Research Intern</h3><p>Collaborated on computer vision and AI research for robot target recognition and autonomous navigation.</p></div>
        </article>
        <article class="affiliation-card">
          <img class="wordmark" src="/images/institutions/zte.jpg" alt="ZTE logo" />
          <div><time>2024.07 — 2024.08</time><h3>ZTE Chengdu · Software Development Intern</h3><p>Built an automated kernel-configuration inspection tool, reducing a 30-minute review to about 5 minutes with over 98% accuracy.</p></div>
        </article>
      </div>
    </section>
  </div>
</BaseLayout>
