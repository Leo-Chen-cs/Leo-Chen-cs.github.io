---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationList from '../components/PublicationList.astro';
import { profile, researchAreas } from '../data/site';

const updates = [
  { date: 'Oct 2026', text: 'Released two new studies on evaluation design and action settlement in intelligent-agent environments.' },
  { date: '2026', text: 'Studying toward an M.S. in Cyberspace Security at the University of Science and Technology of China.' },
  { date: '2025', text: 'DPNet was published in IEEE Internet of Things Journal.' },
];
---

<BaseLayout>
  <div class="site-shell home academic-home">
    <section class="academic-hero">
      <div class="portrait-wrap"><img class="hero-portrait" src="/images/haotian-chen-life.jpg" alt="Portrait of Haotian Chen" width="900" height="900" /></div>
      <div class="hero-copy">
        <p class="eyebrow">LLM Agents · Reliable AI · Computer Vision</p>
        <div class="hero-name"><h1>{profile.name}</h1><span>陈皓天</span></div>
        <p class="hero-role">M.S. student in Cyberspace Security at the <strong>University of Science and Technology of China</strong>.</p>
        <p class="hero-bio">I study how intelligent agents can remember, act, and remain auditable in complex environments. My current interests span reliable LLM-agent evaluation, long-term memory and personalization, social simulation, and embodied intelligence.</p>
        <p class="hero-bio">Previously, I completed a dual-degree undergraduate programme in Computer Science at the <strong>Southwest Jiaotong University–Leeds Joint School</strong>, with degrees awarded by <strong>Southwest Jiaotong University</strong> and the <strong>University of Leeds</strong>. I also conducted research at <strong>Tsinghua AIR</strong> and worked with the operating-system product team at <strong>ZTE</strong>.</p>
        <div class="hero-links" aria-label="Profile links">
          <a href={profile.links.scholar} target="_blank" rel="noreferrer">Google Scholar</a>
          <a href={profile.links.github} target="_blank" rel="noreferrer">GitHub</a>
          <a href={profile.links.arxiv} target="_blank" rel="noreferrer">arXiv</a>
          <a href="/cv/haotian-chen-cv.pdf" download>CV</a>
          <a href={`mailto:${profile.email}`}>Email</a>
        </div>
      </div>
    </section>

    <section class="home-section news-section">
      <div class="section-label"><span>01</span><h2>News</h2></div>
      <div class="news-list">{updates.map((update) => <article><time>{update.date}</time><p>{update.text}</p></article>)}</div>
    </section>

    <section class="home-section research-section" id="research">
      <div class="section-label"><span>02</span><h2>Research</h2></div>
      <div>
        <p class="research-statement">My work connects <strong>agent reliability</strong> with <strong>embodied perception</strong>: how systems make decisions, preserve context, and can be evaluated under controlled conditions.</p>
        <div class="research-list">{researchAreas.map((area) => <article><span>{area.index}</span><div><h3>{area.title}</h3><p>{area.description}</p></div></article>)}</div>
        <a class="section-link" href="/research/">Research overview</a>
      </div>
    </section>

    <section class="home-section publication-section">
      <div class="section-label"><span>03</span><h2>Selected Publications</h2></div>
      <div><PublicationList /><a class="section-link" href={profile.links.scholar} target="_blank" rel="noreferrer">Complete list on Google Scholar</a></div>
    </section>

    <section class="home-section career-section">
      <div class="section-label"><span>04</span><h2>Education & Experience</h2></div>
      <div><div class="affiliation-grid">
        <article class="affiliation-card">
          <img src="/images/institutions/ustc.png" alt="University of Science and Technology of China emblem" />
          <div><time>2026 — 2029</time><h3>University of Science and Technology of China</h3><p>M.S. in Cyberspace Security, focusing on large language model security and reliable agents.</p></div>
        </article>
        <article class="affiliation-card">
          <img src="/images/institutions/swjtu.png" alt="Southwest Jiaotong University emblem" />
          <div><time>2022 — 2026</time><h3>Southwest Jiaotong University</h3><p>Undergraduate study in Computer Science and Technology at the SWJTU–Leeds Joint School. Average 91.23; ranked 8 / 82.</p></div>
        </article>
        <article class="affiliation-card wide-logo-card">
          <img class="wide-wordmark" src="/images/institutions/leeds.svg" alt="University of Leeds logo" />
          <div><time>2022 — 2026</time><h3>University of Leeds</h3><p>Dual-degree undergraduate programme in Computer Science through the SWJTU–Leeds Joint School.</p></div>
        </article>
        <article class="affiliation-card">
          <img src="/images/institutions/tsinghua.jpg" alt="Tsinghua University emblem" />
          <div><time>2024.07 — 2025.04</time><h3>Tsinghua AIR · Research Intern</h3><p>Collaborated on computer vision and AI research for robot target recognition and autonomous navigation.</p></div>
        </article>
        <article class="affiliation-card">
          <img class="wordmark" src="/images/institutions/zte.jpg" alt="ZTE logo" />
          <div><time>2024.07 — 2024.08</time><h3>ZTE Chengdu · Software Development Intern</h3><p>Built an automated kernel-configuration inspection tool, reducing a 30-minute review to about 5 minutes with over 98% accuracy.</p></div>
        </article>
      </div><a class="section-link" href="/cv/">Full curriculum vitae</a></div>
    </section>
  </div>
</BaseLayout>
