---
import { publications } from '../data/site';
interface Props { limit?: number; }
const { limit } = Astro.props;
const items = typeof limit === 'number' ? publications.slice(0, limit) : publications;
---

<div class="pub-list">
  {items.map((paper, index) => (
    <article class="publication">
      <a class="publication-figure" href={paper.href} target="_blank" rel="noreferrer" aria-label={`Open ${paper.title}`}>
        <span class="figure-index">PAPER · {String(index + 1).padStart(2, '0')}</span>
        <span class="figure-title">{paper.title}</span>
        <span class="figure-year">{paper.year}</span>
      </a>
      <div>
        <h3><a href={paper.href} target="_blank" rel="noreferrer">{paper.title}</a></h3>
        <p class="pub-authors">{paper.authors}</p>
        <p class="pub-summary">{paper.summary}</p>
        <div class="pub-meta"><strong>{paper.note}</strong><span>{paper.venue}</span><a class="text-link" href={paper.href} target="_blank" rel="noreferrer">Paper</a></div>
      </div>
    </article>
  ))}
</div>
