---
import { profile } from '../data/site';
---

<footer class="site-footer">
  <div class="shell footer-inner">
    <p>© {new Date().getFullYear()} Haotian Chen</p>
    <div class="footer-links" aria-label="Contact links">
      <a href={`mailto:${profile.email}`}>Email</a>
      <a href={profile.links.arxiv} target="_blank" rel="noreferrer">arXiv</a>
      <a href={profile.links.github} target="_blank" rel="noreferrer">GitHub</a>
      <a href={profile.links.scholar} target="_blank" rel="noreferrer">Google Scholar</a>
    </div>
  </div>
</footer>
